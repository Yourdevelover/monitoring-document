prisma:query SELECT "public"."activity_logs"."id", "public"."activity_logs"."actorId", "public"."activity_logs"."action", "public"."activity_logs"."targetType", "public"."activity_logs"."targetId", "public"."activity_logs"."description", "public"."activity_logs"."ipAddress", "public"."activity_logs"."userAgent", "public"."activity_logs"."createdAt" FROM "public"."activity_logs" WHERE ("public"."activity_logs"."action" = $1 AND "public"."activity_logs"."actorId" IN ($2,$3,$4,$5,$6,$7,$8)) ORDER BY "public"."activity_logs"."createdAt" DESC OFFSET $9
