generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEADER
  KARYAWAN
  MANAJER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  REJECTED
}

enum FileCategory {
  DAILY
  CHAT
  PAYMENT
  OTHER
}

enum UploadStatus {
  WAITING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id            Int          @id @default(autoincrement())
  name          String
  nik           String?        @unique
  email         String       @unique
  phoneNumber   String?
  address       String?
  passwordHash  String
  role          Role
  teamId        Int?
  departmentId  Int?
  position      String?
  isActive      UserStatus   @default(ACTIVE)
  profilePicture String?
  personalNotes Json         @default("[]")
  profileRequests Json       @default("[]")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  team            Team?            @relation("TeamMembers", fields: [teamId], references: [id])
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ledTeam         Team?            @relation("TeamLeader")
  uploads         Upload[]
  announcements   Announcement[]
  activityLogs    ActivityLog[]
  targets       Target[]

  @@map("users")
}

model Team {
  id         Int      @id @default(autoincrement())
  name       String
  leaderId   Int      @unique
  departmentId Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leader     User     @relation("TeamLeader", fields: [leaderId], references: [id])
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  members    User[]    @relation("TeamMembers")
  uploads    Upload[]
  announcements Announcement[]

  @@map("teams")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams     Team[]
  users     User[]

  @@map("departments")
}

model Upload {
  id            Int          @id @default(autoincrement())
  userId        Int
  teamId        Int
  title         String
  fileName      String
  filePath      String
  fileType      String
  category      FileCategory
  status        UploadStatus @default(PROCESSING)
  submissionDate DateTime    @default(now())
  note          String?
  isSubmitted   Boolean      @default(false)
  isImportant   Boolean      @default(false)
  importantSaved Boolean      @default(false)
  importantCopyPath String?
  importantSavedAt DateTime?
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id])
  team          Team         @relation(fields: [teamId], references: [id])

  @@index([teamId, category, submissionDate])
  @@index([userId, importantSavedAt])
  @@map("uploads")
}

model Announcement {
  id            Int       @id @default(autoincrement())
  leaderId      Int
  teamId        Int
  title         String
  content       String
  isPinned      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  leader        User      @relation(fields: [leaderId], references: [id])
  team          Team      @relation(fields: [teamId], references: [id])

  @@map("announcements")
}

model ActivityLog {
  id            Int       @id @default(autoincrement())
  actorId       Int?
  action        String
  targetType    String?
  targetId      Int?
  description   String
  createdAt     DateTime  @default(now())

  actor         User?     @relation(fields: [actorId], references: [id])

  @@map("activity_logs")
}

model Target {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String
  targetValue  Float
  currentValue Float    @default(0)
  formula      String
  threshold    Float    @default(20)
  period       String
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, name])
  @@index([period, isPublic])
  @@map("targets")
}
